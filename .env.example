# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
# Go to Project Settings > API to find your project URL and anon key

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Encryption secret for Gemini API keys stored in the database.
# Must be a 64-character hex string (32 bytes / 256 bits).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GEMINI_KEY_ENCRYPTION_SECRET=
